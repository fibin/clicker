<Window x:Class="Clicker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicker overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <!-- Outer margin leaves room for the drop shadow. -->
    <Border x:Name="Pill" Margin="6" CornerRadius="16" Background="#E6111827" Padding="12,6"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#9CA3AF" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Margin="8,0,0,0" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="DetailText" Margin="8,0,0,0" Foreground="#D1D5DB" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MoveHintText" Margin="10,0,0,0" Foreground="#93C5FD" FontSize="12"
                       VerticalAlignment="Center" Visibility="Collapsed" Text="✥" />
        </StackPanel>
    </Border>
</Window>
