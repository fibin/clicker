<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Clicker</RootNamespace>
    <AssemblyName>Clicker</AssemblyName>
    <ApplicationIcon>Assets\clicker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Run on .NET 8 or any newer installed runtime (9, 10, ...) -->
    <RollForward>Major</RollForward>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Product>Clicker</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\clicker.ico" />
    <Resource Include="Assets\clicker_active.ico" />
    <Resource Include="Assets\clicker.png" />
  </ItemGroup>

</Project>
